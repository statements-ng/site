---
---
<section class="relative py-28 px-6 border-t border-[#1e2530]/50 overflow-hidden">
  <!-- Background glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(59,130,246,0.1)_0%,transparent_70%)] pointer-events-none"></div>
  <!-- Grid -->
  <div
    class="absolute inset-0 opacity-[0.025]"
    style="background-image: linear-gradient(#3b82f6 1px, transparent 1px), linear-gradient(to right, #3b82f6 1px, transparent 1px); background-size: 40px 40px;"
  ></div>

  <div class="relative z-10 max-w-3xl mx-auto text-center">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#3b82f6]/30 bg-[#3b82f6]/10 text-xs text-[#60a5fa] mb-6 font-mono">
      <span class="w-1.5 h-1.5 rounded-full bg-[#3b82f6] animate-pulse"></span>
      Ready when you are
    </div>

    <h2 class="text-4xl md:text-6xl font-extrabold tracking-tight text-[#e8edf5] mb-5 leading-[1.05]">
      Stop reading PDFs.<br />
      <span class="gradient-text">Start reading data.</span>
    </h2>

    <p class="text-lg text-[#6b7a91] mb-10 max-w-xl mx-auto leading-relaxed">
      Join businesses, accountants and analysts across Nigeria who use Statements NG to turn messy bank PDFs into actionable data — in seconds.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="https://app.statements.ng"
        target="_blank"
        rel="noopener noreferrer"
        class="group flex items-center gap-2.5 px-8 py-4 rounded-xl bg-[#3b82f6] hover:bg-[#2563eb] text-white font-semibold text-base transition-all shadow-2xl shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-0.5"
      >
        Start parsing for free
        <svg class="group-hover:translate-x-0.5 transition-transform" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <p class="mt-6 text-xs text-[#6b7a91] font-mono">
      No subscription needed · Credits never expire · ₦10/page
    </p>
  </div>
</section>
