---
const features = [
  {
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 2L12.09 7.26L18 8L13.5 12.14L14.82 18L10 15.27L5.18 18L6.5 12.14L2 8L7.91 7.26L10 2Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    label: 'Blazing Fast',
    title: 'Seconds, not hours',
    body: 'Our parser processes multi-page PDF statements in under two seconds. Upload, parse, done — no waiting, no frustration. We handle the heavy lifting so you can focus on the numbers.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 7H13M7 10H13M7 13H10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
    label: 'Bank-Tailored',
    title: 'Built for Nigerian banks',
    body: 'Every Nigerian bank formats its statement differently. We\'ve reverse-engineered the latest layouts from all major banks — including recent template changes — so nothing slips through.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 18C14.4183 18 18 14.4183 18 10C18 5.58172 14.4183 2 10 2C5.58172 2 2 5.58172 2 10C2 14.4183 5.58172 18 10 18Z" stroke="currentColor" stroke-width="1.6"/><path d="M7 10L9 12L13 8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    label: 'High Accuracy',
    title: 'Accurate to the kobo',
    body: 'Amounts, dates, narrations, debits, credits and running balances — all extracted with 99.9% fidelity. Built-in cross-validation flags discrepancies before you ever see them.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 14L8 10L11 13L15 8M15 8H11M15 8V12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    label: 'Smart Analysis',
    title: 'Instant spending insights',
    body: 'Automatically categorise transactions, identify recurring payments, spot income patterns and generate monthly summaries — all without lifting a finger.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 3V13M6 9L10 13L14 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 16H17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
    label: 'Flexible Export',
    title: 'Export in any format',
    body: 'Download your structured data as CSV, Excel, or JSON. Pipe it straight into your spreadsheets, accounting software, or data pipelines without any reformatting.',
  },
  {
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 2C6.69 2 4 4.69 4 8C4 12.5 10 18 10 18C10 18 16 12.5 16 8C16 4.69 13.31 2 10 2Z" stroke="currentColor" stroke-width="1.6"/><circle cx="10" cy="8" r="2" stroke="currentColor" stroke-width="1.6"/></svg>`,
    label: 'Credits Model',
    title: 'Pay only for what you use',
    body: 'No subscriptions, no minimums. Buy credits, spend them per page. Parse a single page or ten thousand — the pricing scales with your exact needs, nothing more.',
  },
];
---

<section id="features" class="relative py-28 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Section header -->
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#1e2530] bg-[#0f1318] text-xs text-[#6b7a91] mb-5 font-mono">
        Features
      </div>
      <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-[#e8edf5] mb-4">
        Everything you need.<br />
        <span class="text-[#6b7a91]">Nothing you don't.</span>
      </h2>
      <p class="text-[#6b7a91] text-lg max-w-xl mx-auto">
        Purpose-built for the Nigerian banking ecosystem. No generic tools, no guesswork.
      </p>
    </div>

    <!-- Features grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((f) => (
        <div class="group relative p-6 rounded-xl border border-[#1e2530] bg-[#0f1318] hover:border-[#2d3748] hover:bg-[#131820] transition-all">
          <!-- Subtle top gradient line on hover -->
          <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-[#3b82f6]/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity rounded-t-xl"></div>

          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-[#161b23] border border-[#1e2530] flex items-center justify-center text-[#3b82f6] group-hover:bg-[#1d2535] group-hover:border-[#2d3748] transition-all">
              <Fragment set:html={f.icon} />
            </div>
            <div>
              <span class="inline-block text-[10px] font-mono uppercase tracking-widest text-[#3b82f6] mb-1">{f.label}</span>
              <h3 class="text-[15px] font-semibold text-[#e8edf5] mb-2">{f.title}</h3>
              <p class="text-sm text-[#6b7a91] leading-relaxed">{f.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
