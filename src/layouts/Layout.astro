---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'Statements NG — Nigerian Bank Statement Parser',
  description = 'Parse, analyse and export Nigerian bank statements in seconds. Supports all major Nigerian banks. Blazing fast, accurate, and tailored to the latest bank statement layouts.',
  canonical = 'https://statements.ng',
  ogImage = 'https://statements.ng/og.png',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="bank statement parser, Nigerian bank statements, parse bank statement, GTBank statement, Access Bank statement, Zenith Bank statement, UBA statement, First Bank statement, bank statement analyser, Nigeria fintech, statement NG, statements NG" />
    <meta name="author" content="Statements NG" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Statements NG" />
    <meta property="og:locale" content="en_NG" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Statements NG",
      "url": "https://statements.ng",
      "applicationCategory": "FinanceApplication",
      "operatingSystem": "Web",
      "description": description,
      "offers": {
        "@type": "Offer",
        "priceCurrency": "NGN",
        "price": "10",
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": "10",
          "priceCurrency": "NGN",
          "unitText": "per page"
        }
      },
      "provider": {
        "@type": "Organization",
        "name": "Statements NG",
        "url": "https://statements.ng"
      }
    })} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="bg-[#090b0f] text-[#e8edf5]">
    <slot />
  </body>
</html>
